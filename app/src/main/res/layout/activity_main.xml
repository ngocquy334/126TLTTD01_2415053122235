<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_with="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:layout_with="wrap_content"
        android:layout_height="wrap_content"
        android:text="Họ và tên: Trương Ngọc Quý - MSSV: 2415053122235"
        android:textStyle="bold"/>
    <EditText android:id="@+id/etName"
        android:layout_with="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tên học phần"/>
    <TextView android:id="@+id/tvErrName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textcolor="#F00"
        android:víibility="gone"/>
    <EditText android:id="@+id/etQT"
        android:layout_with="match_parent"
        android:layout_height="wrap_content"
        android:hint="Điểm QT"
        android:inputtype="numberDecimal"/>
    <TextView android:id="@+id/tvErrQT"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textcolor="#F00"
        android:visibility="gone"/>
    <EditText android:id="@+id/etCK"
        android:layout_with="match_parent"
        android:layout_height="wrap_content"
        android:hint="Điểm Ck"
        android:inputtype="numberDecimal"/>
    <TextView android:id="@+id/tvErrCK"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textcolor="#F00"
        android:visibility="gone"/>
    <LinearLayout
        android:layout_with="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <Button android:id="@+id/btnCheck"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Kiểm tra"/>
        <Button android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Xoá"/>
    </LinearLayout>
    <TextView android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="16sp"
        android:textStyle="bold"/>
</LinearLayout>